# Server environment configuration
# Copy this file to .env and fill in the values

# VLM Backend: "ollama" (local) or "openai" (compatible with vLLM, Together AI, Groq, Gemini)
VLM_BACKEND=ollama

# Model name
# For Ollama: llava:7b, llava:13b, qwen2.5-vl:7b, etc.
# For OpenAI: gpt-4o-mini, gpt-4o, etc.
# For Gemini: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash-exp
# For vLLM: Qwen/Qwen2.5-VL-7B-Instruct, etc.
VLM_MODEL=llava:7b

# Ollama host (only for backend=ollama)
OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible API settings (only for backend=openai/vllm/together/groq/gemini)
# VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ (for Gemini)
# VLM_BASE_URL=http://localhost:8001/v1 (for local vLLM)
# VLM_API_KEY=your-api-key

# Server port
PORT=8000
