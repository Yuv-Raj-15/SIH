# PrivacyVision Server Environment Configuration

# =====================================================================
# 1. LOCAL ON-DEVICE OLLAMA CONFIGURATION (Fast, Airtight & On-Device)
# =====================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava:7b

# =====================================================================
# 2. VLM REASONING BACKEND SELECTION:
# =====================================================================
# Option A: "ollama" (100% LOCAL & AIRTIGHT — Zero data leaves this PC)
# Option B: "openai" (OpenAI / Gemini / Groq compatible API)
VLM_BACKEND=openai

# Model name for reasoning:
# When VLM_BACKEND=ollama: llava:7b
# When VLM_BACKEND=openai (Gemini): gemini-2.0-flash
# When VLM_BACKEND=openai (Groq): llama-3.2-11b-vision-preview
VLM_MODEL=gpt-5.6-luna

# =====================================================================
# 3. CLOUD API CREDENTIALS (Only utilized if VLM_BACKEND=openai)
# =====================================================================
# For Google Gemini (Sub-2s latency):
# VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VLM_API_KEY=YOUR_GEMINI_API_KEY
# VLM_MODEL=gemini-2.0-flash

# For Groq (Sub-1s latency):
# VLM_BASE_URL=https://api.groq.com/openai/v1
# VLM_API_KEY=YOUR_GROQ_API_KEY
# VLM_MODEL=llama-3.2-11b-vision-preview

# Legacy ExperientialLabs endpoint (hit 429 rate limit):
VLM_BASE_URL=https://api.experientiallabs.ai/v1
VLM_API_KEY=xpl_279ff4417cc14228feeff8ef50c6c6152e32aeab

# Server port
PORT=8000
