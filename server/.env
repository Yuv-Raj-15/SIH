# PrivacyVision Server Environment Configuration

# =====================================================================
# 1. LOCAL ON-DEVICE OLLAMA CONFIGURATION (Always Active for PII Guard)
# =====================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava:7b

# =====================================================================
# 2. VLM REASONING BACKEND SELECTION:
# =====================================================================
# Option A: "ollama" (100% LOCAL & AIRTIGHT — Zero data leaves this PC)
# Option B: "openai" (HYBRID — Local Ollama PII Guard + Cloud Planner)
VLM_BACKEND=openai

# Model name for reasoning:
# When VLM_BACKEND=ollama: llava:7b
# When VLM_BACKEND=openai: gpt-5.6-luna
VLM_MODEL=gpt-5.6-luna

# =====================================================================
# 3. CLOUD API CREDENTIALS (Only utilized if VLM_BACKEND=openai)
# =====================================================================
VLM_BASE_URL=https://api.experientiallabs.ai/v1
VLM_API_KEY=xpl_279ff4417cc14228feeff8ef50c6c6152e32aeab

# Server port
PORT=8000
